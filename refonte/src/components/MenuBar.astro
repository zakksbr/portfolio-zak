---
interface Props {
    world: 'informatique' | 'arbitrage'
    links: { href: string; label: string }[]
}

const { world, links } = Astro.props
const appName = world === 'arbitrage' ? 'Arbitrage' : 'Portfolio'
const worlds = [
    { href: '/', label: 'Informatique', current: world === 'informatique' },
    { href: '/arbitrage/', label: 'Arbitrage', current: world === 'arbitrage' },
]
---
<header class="sticky top-0 z-40 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-white/10 bg-[rgba(18,18,20,0.62)] px-4 py-1.5 text-[13px] backdrop-blur-xl backdrop-saturate-150 md:px-5">
    <nav aria-label="Menu principal" class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <a href="/" class="font-display text-[15px] font-black tracking-wide">ZS.</a>
        <span class="font-bold">{appName}</span>
        {links.map(link => (
            <a href={link.href} class="hidden text-ink/85 transition-colors hover:text-white lg:inline">{link.label}</a>
        ))}
    </nav>
    <div class="flex items-center gap-4">
        <div role="group" aria-label="Univers" class="flex gap-0.5 rounded-[7px] border border-white/10 bg-white/10 p-0.5">
            {worlds.map(w => (
                <a
                    href={w.href}
                    aria-current={w.current ? 'page' : undefined}
                    class:list={[
                        'rounded-[5px] px-3 py-1 text-xs transition-colors',
                        w.current ? 'bg-[var(--world-fill)] font-semibold text-[var(--world-on-fill)]' : 'text-ink/80 hover:text-white',
                    ]}
                >{w.label}</a>
            ))}
        </div>
        <time id="menubar-clock" class="hidden min-w-[9.5rem] text-right text-ink/85 sm:inline"></time>
    </div>
</header>
