---
import ClubLogo from './ClubLogo.astro'
import { feedbacks } from '../../data/feedbacks.js'
---
<section id="ref-feedbacks" aria-labelledby="ref-feedbacks-heading" class="flex flex-col gap-8">
    <h2 id="ref-feedbacks-heading" class="section-heading">Retours</h2>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {feedbacks.map((fb, index) => (
            <article class="glass window reveal flex flex-col">
                <div class="flex items-center gap-3 border-b border-white/[0.07] bg-white/[0.03] px-5 py-4">
                    <ClubLogo src={fb.logo1} alt={`Logo ${fb.team1}`} class="h-11 w-11" />
                    <div class="flex min-w-0 flex-1 flex-col items-center text-center">
                        <h3 class="m-0 text-[15px] font-bold leading-snug">{fb.team1} - {fb.team2}</h3>
                        <p class="m-0 text-[13px] text-[#a1a1a6]">Le {fb.date}</p>
                    </div>
                    <ClubLogo src={fb.logo2} alt={`Logo ${fb.team2}`} class="h-11 w-11" />
                </div>
                <div class="flex flex-1 flex-col gap-2 px-5 py-5">
                    <h4 class="label-caps m-0">Appréciation générale :</h4>
                    <p class="m-0 line-clamp-6 text-[#d1d1d6]">"{fb.appreciation}"</p>
                </div>
                <div class="px-5 pb-5">
                    <button type="button" class="btn btn-secondary w-full" data-open-dialog={`feedback-${index}`} aria-haspopup="dialog">Voir le rapport complet</button>
                </div>
            </article>
        ))}
    </div>
</section>
