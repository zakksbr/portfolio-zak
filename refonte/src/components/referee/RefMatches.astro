---
import Pic from '../Pic.astro'

type Row = {
    label: string
    sub?: string
    badge?: string
    badgeAfter?: boolean
    count?: string
    role: 'central' | 'assistant'
    logos?: { src: string; alt: string }[]
    levels?: { label: string; badge: string }[]
}

type Competition = {
    name: string
    logo?: { src: string; alt: string; class?: string }
    emoji?: string
    rows: Row[]
}


const sam = { src: 'assets/img/SAM.svg', alt: 'SAM Football' }

const competitions: Competition[] = [
    {
        name: 'Championnat départemental',
        logo: { src: 'assets/img/DISTRICT.png', alt: 'District' },
        rows: [
            { badge: 'D2', label: 'Senior Départementale 2', count: '1 Match', role: 'central' },
            { badge: 'U17', label: 'U17 Départementale 4', count: '2 Matchs', role: 'central' },
            { badge: 'U15', label: 'U15 Départementale 3', count: '1 Match', role: 'central' },
        ],
    },
    {
        name: 'Championnat régional · Ligue Nouvelle-Aquitaine',
        logo: { src: 'assets/img/lfna.png', alt: 'Ligue de Football Nouvelle-Aquitaine' },
        rows: [
            { badge: 'R2', label: 'U17 Régional 2 · Poule B · J4', sub: 'Fronsadais Foot ES 2 - 2 APFC · 26/09/2026', count: '1 Match', role: 'central' },
        ],
    },
    {
        name: 'Coupe de France',
        logo: { src: 'assets/img/coupe-de-france-logo.png', alt: 'Coupe de France Crédit Agricole' },
        rows: [
            { badge: 'R3', badgeAfter: true, label: 'Sénior Régionale 3', sub: 'Estuaire Haute Gironde - Cenon · 30/08/2026', count: '1 Match', role: 'assistant' },
        ],
    },
    {
        name: 'Coupe Gambardella Crédit Agricole',
        logo: { src: 'assets/img/logo-gambard.svg', alt: 'Coupe Gambardella Crédit Agricole' },
        rows: [
            { label: 'Fronsadais Foot ES - Barpais FC', sub: '05/09/2026', count: '1 Match', role: 'central' },
            { label: 'St Augustin CPA USJ - Macaudaise SJ', sub: '19/09/2026', count: '1 Match', role: 'central' },
        ],
    },
    {
        name: 'U19 Brassage Win Sport School',
        emoji: '⚽',
        rows: [
            { label: 'Targon Soulignac FC 0 - 7 Lormont US', sub: 'Phase 1 · Poule B · 12/09/2026', count: '1 Match', role: 'central' },
            { label: 'Bruges ES 1 - 3 Lège Cap Ferret US', sub: 'Phase 1 · Poule A · 11/10/2026', count: '1 Match', role: 'central', logos: [{ src: 'assets/img/bruges.png', alt: 'ES Bruges' }, { src: 'assets/img/lege-cap-ferret.png', alt: 'Lège Cap Ferret US' }] },
        ],
    },
    {
        name: 'Matchs Amicaux',
        emoji: '🤝',
        rows: [
            {
                label: 'SAM Football - Trélissac',
                logos: [sam, { src: 'assets/img/tfc.png', alt: 'Trélissac FC' }],
                levels: [{ label: 'Séniors R1', badge: 'R1' }, { label: 'National 2', badge: 'N2' }],
                role: 'assistant',
            },
            {
                label: 'SAM Football - Girondins de Bordeaux',
                logos: [sam, { src: 'assets/img/FCGB.jpg.png', alt: 'Girondins de Bordeaux' }],
                levels: [{ label: 'Séniors R1', badge: 'R1' }],
                role: 'assistant',
            },
        ],
    },
]

const roleLabel = { central: 'Central', assistant: 'Assistant' }
---
<section id="ref-matches" aria-labelledby="ref-matches-heading" class="reveal flex flex-col gap-8">
    <h2 id="ref-matches-heading" class="section-heading">Matchs Joués</h2>
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        {competitions.map(comp => (
            <article class="glass window flex flex-col">
                <div class="flex items-center gap-3.5 border-b border-white/[0.07] bg-white/[0.03] px-5 py-4">
                    {comp.logo && (
                        <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-white p-1.5">
                            <Pic src={comp.logo.src} alt={comp.logo.alt} width={120} class="max-h-full max-w-full object-contain" />
                        </span>
                    )}
                    {comp.emoji && <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-white/[0.08] text-2xl" aria-hidden="true">{comp.emoji}</span>}
                    <h3 class="m-0 text-base font-bold md:text-lg">{comp.name}</h3>
                </div>
                <div class="flex flex-col">
                    {comp.rows.map((row, i) => (
                        <div class:list={['flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-3.5', { 'border-t border-white/[0.07]': i > 0 }]}>
                            <div class="flex min-w-0 flex-col gap-1.5">
                                {row.logos && (
                                    <span class="flex items-center gap-2">
                                        <span class="club-logo h-8 w-8"><Pic src={row.logos[0].src} alt={row.logos[0].alt} width={80} /></span>
                                        <span aria-hidden="true">-</span>
                                        <span class="club-logo h-8 w-8"><Pic src={row.logos[1].src} alt={row.logos[1].alt} width={80} /></span>
                                    </span>
                                )}
                                <span class="flex flex-wrap items-center gap-2 font-medium">
                                    {row.badge && !row.badgeAfter && <span class={`m-badge badge-${row.badge.toLowerCase()}`}>{row.badge}</span>}
                                    {row.label}
                                    {row.badge && row.badgeAfter && <span class={`m-badge badge-${row.badge.toLowerCase()}`}>{row.badge}</span>}
                                </span>
                                {row.sub && <span class="text-[13px] text-[#a1a1a6]">{row.sub}</span>}
                            </div>
                            <div class="flex flex-wrap items-center gap-2.5">
                                {row.levels && (
                                    <span class="flex flex-col gap-1.5 text-sm">
                                        {row.levels.map(level => (
                                            <span class="flex items-center gap-2">{level.label} <span class={`m-badge badge-${level.badge.toLowerCase()}`}>{level.badge}</span></span>
                                        ))}
                                    </span>
                                )}
                                {row.count && <span class="text-sm font-semibold text-[#d1d1d6]">{row.count}</span>}
                                <span class:list={['m-role', `role-${row.role}`]}>{roleLabel[row.role]}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </article>
        ))}
    </div>
</section>
