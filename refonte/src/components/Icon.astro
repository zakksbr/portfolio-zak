    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={className}
>
    {d.map(path => <path d={path} />)}
</svg>
